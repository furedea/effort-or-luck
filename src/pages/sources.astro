---
import { assumptionsNote, BACK_TO_GAME, SOURCES_TITLE } from "../copy/screen";
import { SOURCES } from "../data/statistics";
import BaseLayout from "../layouts/base_layout.astro";
import { LINKS } from "../links";
import "../styles/game.css";
---

<BaseLayout title={SOURCES_TITLE}>
  <main class="sources">
    <h1 class="when">{SOURCES_TITLE}</h1>
    <ul>
      {Object.values(SOURCES).map((source) => <li>{source}</li>)}
    </ul>
    <p>{assumptionsNote()}</p>
    <a href={LINKS.game}>{BACK_TO_GAME}</a>
  </main>
</BaseLayout>
