{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react: this project is a React app
  "plugins": ["typescript", "react", "import", "promise", "node", "vitest"],
  // .astro/**: Astro build output
  "ignorePatterns": [".astro/**", "coverage/**", "dist/**", "node_modules/**"],
  "settings": {
    "vitest": {
      "typecheck": true
    }
  },
  "rules": {
    "complexity": ["error", { "max": 10 }],
    "import/no-cycle": "error",
    "max-depth": ["error", { "max": 2 }],
    "max-lines": ["error", { "max": 500 }],
    "max-params": ["error", { "max": 3 }],
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true }],
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      // *.test.tsx and *.spec.tsx: React component tests
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "globals": {
        "afterAll": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "describe": "readonly",
        "expect": "readonly",
        "it": "readonly",
        "test": "readonly",
        "vi": "readonly"
      }
    },
    {
      // The engine is pure calculation: keep copy, data, and UI out of it.
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/copy/**",
                  "**/data/**",
                  "react",
                  "react-dom",
                  "react/**",
                  "astro",
                  "astro/**",
                  "@astrojs/**"
                ],
                "message": "The engine is pure calculation: no copy, data, or UI imports."
              }
            ]
          }
        ]
      }
    }
  ]
}
