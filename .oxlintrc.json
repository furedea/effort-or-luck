{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "promise", "node", "vitest"],
  "ignorePatterns": [".astro/**", "coverage/**", "dist/**", "node_modules/**"],
  "settings": {
    "vitest": {
      "typecheck": true
    }
  },
  "rules": {
    "import/no-cycle": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "globals": {
        "afterAll": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "describe": "readonly",
        "expect": "readonly",
        "it": "readonly",
        "test": "readonly",
        "vi": "readonly"
      }
    },
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/copy/**",
                  "**/data/**",
                  "react",
                  "react-dom",
                  "react/**",
                  "astro",
                  "astro/**",
                  "@astrojs/**"
                ],
                "message": "The engine is pure calculation: no copy, data, or UI imports."
              }
            ]
          }
        ]
      }
    }
  ]
}
